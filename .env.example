APP_NAME="Wecar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DOMAIN=wecar.mx
APP_PORT=8000
VITE_PORT=5173
CERTBOT_EMAIL=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
RUN_MIGRATIONS=true

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos (local con docker-compose; producción DigitalOcean Managed PostgreSQL)
DB_CONNECTION=pgsql

# false = PostgreSQL local del compose | true = PostgreSQL remoto (DigitalOcean)
DB_REMOTE=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wecar
DB_USERNAME=wecar
DB_PASSWORD=secret
# En producción: require
DB_SSLMODE=prefer

# Base de datos remota (solo si DB_REMOTE=true)
DB_REMOTE_HOST=
DB_REMOTE_PORT=25060
DB_REMOTE_DATABASE=
DB_REMOTE_USERNAME=
DB_REMOTE_PASSWORD=
DB_REMOTE_SSLMODE=require

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En producción usar resend
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@wecar.mx"
MAIL_FROM_NAME="${APP_NAME}"

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Inertia SSR
INERTIA_SSR_ENABLED=true

# Horizon
HORIZON_PATH=horizon
INERTIA_SSR_URL=http://127.0.0.1:13714

# Admin inicial
ADMIN_EMAIL=admin@wecar.mx
ADMIN_PASSWORD=
ADMIN_NAME="Admin Wecar"

# Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@wecar.mx

# Integraciones
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
EXTERNAL_SEARCH_ENABLED=true
EXTERNAL_SEARCH_DEBUG=false
EXTERNAL_SEARCH_FREE_SEARCHES=3
EXTERNAL_SEARCH_FREE_VIEWS=15
EXTERNAL_SEARCH_CACHE_DAYS=7
EXTERNAL_SEARCH_MEMORY_TTL=30
EXTERNAL_SEARCH_TIMEZONE=America/Monterrey
TOKEN_COUPON_CODE=TKNS50
APIFY_FACEBOOK_ENABLED=false
APIFY_FB_LOCATION=mexicocity
APIFY_FB_RESULTS_LIMIT=12
APIFY_FB_TIMEOUT_SECONDS=90
APIFY_FB_INCLUDE_DETAILS=false
APIFY_TOKEN=
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_SHARED_SECRET=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API=https://api-m.sandbox.paypal.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# DigitalOcean Spaces (producción, opcional)
# Cambiar FILESYSTEM_DISK=s3 para usar Spaces.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=nyc3
AWS_BUCKET=
AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
